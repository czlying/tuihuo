<view class="page">

  <image wx:if="{{pageBg}}" class="page-bg" src="{{pageBg}}" mode="aspectFill" />

  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">正在读取…</text>
  </view>

  <block wx:else>

    <view wx:if="{{errorMsg}}" class="alert">
      <text class="alert-text">{{errorMsg}}</text>
    </view>

    <!-- 状态条：已申请 / 已取货 -->
    <view wx:if="{{mode === 'edit' && (status === 'applied' || status === 'picked')}}" class="done-strip">
      <text class="done-title">{{status === 'picked' ? '已取货' : '上门取件'}}</text>
      <text wx:if="{{status === 'picked' && pickedAtText}}" class="done-date">取货于 {{pickedAtText}}</text>
      <text wx:if="{{status === 'applied' && appliedAtText}}" class="done-date">申请于 {{appliedAtText}}</text>
    </view>

    <!-- 截图 OCR 识别入口：仅新建时显示，识别结果回填表单由用户核对 -->
    <view wx:if="{{mode === 'create'}}" class="ocr-entry tap" bindtap="onOcrPick">
      <view class="ocr-icon">📷</view>
      <view class="ocr-body">
        <text class="ocr-title">拍订单截图，自动填</text>
        <text class="ocr-sub">{{ocrBusy ? '识别中，请稍候…' : '识别商品、金额、日期，你再核对补全'}}</text>
      </view>
      <text class="ocr-arrow">›</text>
    </view>

    <!-- ------------------------------------------------ 商品与平台 -->
    <view class="field">
      <text class="field-label">商品名</text>
      <input
        class="field-input"
        value="{{productName}}"
        placeholder="例如：白色球鞋"
        placeholder-class="ph"
        maxlength="60"
        data-field="productName"
        bindinput="onFieldInput"
      />
    </view>

    <view class="field">
      <text class="field-label">平台</text>
      <picker
        mode="selector"
        range="{{platformNames}}"
        value="{{platformIndex}}"
        bindchange="onPlatformChange"
      >
        <view class="field-picker">
          <text class="{{platform ? 'picker-value' : 'picker-placeholder'}}">
            {{platform || '选择购买平台'}}
          </text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">金额</text>
      <view class="field-money">
        <text class="money-symbol">¥</text>
        <input
          class="money-input num"
          type="digit"
          value="{{amountYuan}}"
          placeholder="0.00"
          placeholder-class="ph"
          data-field="amountYuan"
          bindinput="onFieldInput"
        />
      </view>
    </view>

    <view class="rule"></view>

    <!-- ------------------------------------------------ 时效 -->
    <view class="field-row">
      <view class="field field-half field-half-first">
        <text class="field-label">申请退货日期</text>
        <picker mode="date" value="{{receiveDate}}" start="2010-01-01" end="{{today}}" bindchange="onReceiveDateChange">
          <view class="field-picker">
            <text class="picker-value num">{{receiveDate}}</text>
          </view>
        </picker>
      </view>

      <view class="field field-half">
        <text class="field-label">退货天数</text>
        <view class="stepper">
          <view class="stepper-btn tap" data-delta="-1" bindtap="onDaysStep">
            <text>−</text>
          </view>
          <text class="stepper-value num">{{returnDays}}</text>
          <view class="stepper-btn tap" data-delta="1" bindtap="onDaysStep">
            <text>+</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最晚可退日：自动算，也能手动改 -->
    <view class="deadline-box">
      <view class="deadline-head">
        <text class="section-label">⏰ 最晚可退日</text>
        <text class="deadline-tag {{deadlineOverridden ? 'is-manual' : ''}}">
          {{deadlineOverridden ? '已手动指定' : '自动计算'}}
        </text>
      </view>

      <view class="deadline-body">
        <picker
          wx:if="{{deadlineOverridden}}"
          mode="date"
          value="{{deadline}}"
          bindchange="onDeadlineChange"
        >
          <text class="deadline-value num">{{deadline}}</text>
        </picker>
        <text wx:else class="deadline-value num">{{deadline}}</text>

        <picker class="deadline-time-picker" mode="multiSelector" range="{{deadlineTimeRange}}" value="{{deadlineTimeIndex}}" bindchange="onDeadlineTimeChange">
          <text class="deadline-time num">{{deadlineTime}}</text>
        </picker>

        <view class="deadline-actions">
          <picker
            wx:if="{{!deadlineOverridden}}"
            mode="date"
            value="{{deadline}}"
            bindchange="onDeadlineChange"
          >
            <text class="link">改</text>
          </picker>
          <text wx:else class="link" bindtap="onResetDeadline">恢复自动</text>
        </view>
      </view>

      <text class="deadline-hint">申请退货日 + {{returnDays}} 天，可手动改。</text>
    </view>

    <view wx:if="{{mode === 'create'}}" class="considering-field">
      <view class="considering-copy">
        <text class="considering-title">想退货</text>
        <text class="considering-sub">还在犹豫，先放进「想退货名单」</text>
      </view>
      <switch checked="{{considering}}" color="#e0a23c" bindchange="onConsideringChange" />
    </view>

    <view class="rule"></view>

    <!-- ------------------------------------------------ 取件码 / 订单编号 / 退货原因 -->
    <view class="field">
      <text class="field-label">取件码</text>
      <input
        class="field-input num"
        value="{{pickupCode}}"
        placeholder="上门取件的取件码，没有可不填"
        placeholder-class="ph"
        maxlength="30"
        data-field="pickupCode"
        bindinput="onFieldInput"
      />
    </view>

    <view class="field">
      <text class="field-label">订单编号</text>
      <input
        class="field-input num"
        value="{{orderNo}}"
        placeholder="订单编号/订单号，如 3316356807100404082"
        placeholder-class="ph"
        maxlength="64"
        data-field="orderNo"
        bindinput="onFieldInput"
      />
      <text wx:if="{{orderNoDupText}}" class="field-error">{{orderNoDupText}}</text>
    </view>

    <view class="field">
      <text class="field-label">退货原因</text>
      <input
        class="field-input"
        value="{{returnReason}}"
        placeholder="例如：尺码不合适"
        placeholder-class="ph"
        maxlength="40"
        data-field="returnReason"
        bindinput="onFieldInput"
      />
    </view>

    <view class="field">
      <text class="field-label">凭证</text>
      <view class="voucher-list">
        <view wx:for="{{voucher}}" wx:key="*this" class="voucher-item">
          <image class="voucher-img" src="{{item}}" mode="aspectFill" />
          <view class="voucher-del tap" data-index="{{index}}" bindtap="onRemoveImage">
            <text>×</text>
          </view>
        </view>

        <view wx:if="{{voucher.length < 3}}" class="voucher-add tap" bindtap="onChooseImage">
          <text class="voucher-add-plus">+</text>
          <text class="voucher-add-text">添加</text>
        </view>
      </view>
    </view>

    <!-- ------------------------------------------------ 操作区 -->
    <view class="actions">
      <view class="btn-primary tap" bindtap="onSubmit">
        <text>{{mode === 'edit' ? '保存修改' : '保存'}}</text>
      </view>

      <view
        wx:if="{{mode === 'edit' && status === 'pending'}}"
        class="btn-secondary tap"
        bindtap="onMarkApplied"
      >
        <text>标记为上门取件</text>
      </view>

      <view
        wx:if="{{mode === 'edit' && status === 'applied'}}"
        class="btn-secondary tap"
        bindtap="onMarkPicked"
      >
        <text>标记已取货</text>
      </view>

      <view wx:if="{{mode === 'edit'}}" class="btn-danger tap" bindtap="onDelete">
        <text>删除这笔记录</text>
      </view>
    </view>

    <view class="bottom-space"></view>

  </block>

  <!-- 背景水印：不拦截点击 -->
  <pickup-time
    visible="{{pickupPickerVisible}}"
    value="{{pickupTimeDraft}}"
    bind:confirm="onPickupTimeConfirm"
    bind:cancel="onPickupTimeCancel"
  />
</view>
