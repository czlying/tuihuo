/* 录入 / 编辑页 —— 与看板同一套 editorial 语言：细线、下划线输入、克制留白 */

.page {
  padding: 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.rule {
  height: 1rpx;
  background-color: var(--line);
  margin: 44rpx 0;
}

/* ------------------------------------------------------------ 字段 */
.field {
  padding: 34rpx 0 6rpx;
}

.field-label {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 0.1em;
  margin-bottom: 18rpx;
}

.field-input {
  width: 100%;
  font-size: 32rpx;
  color: var(--ink);
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.ph {
  color: var(--ink-3);
  opacity: 0.6;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.picker-value {
  font-size: 32rpx;
  color: var(--ink);
}

.picker-placeholder {
  font-size: 30rpx;
  color: var(--ink-3);
  opacity: 0.7;
}

.picker-arrow {
  font-size: 34rpx;
  color: var(--ink-3);
  line-height: 1;
}

/* 金额：符号与数字同排，数字大一号 */
.field-money {
  display: flex;
  align-items: baseline;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.money-symbol {
  font-size: 30rpx;
  color: var(--ink-2);
  margin-right: 12rpx;
}

.money-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
}

.field-textarea {
  width: 100%;
  min-height: 130rpx;
  font-size: 29rpx;
  color: var(--ink);
  line-height: 1.6;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}

/* ------------------------------------------------------------ 并排字段 */
.field-row {
  display: flex;
  align-items: flex-start;
}

.field-half {
  flex: 1;
  min-width: 0;
}
/* 用显式类名代替 :first-child —— WXSS 对结构性伪类支持不稳定 */
.field-half-first {
  margin-right: 48rpx;
}

/* 天数步进器 */
.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1;
}

.stepper-value {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
}

/* ------------------------------------------------------------ 最晚可退日 */
.deadline-box {
  margin-top: 34rpx;
  padding: 22rpx 28rpx 22rpx;
  background-color: var(--paper-raise);
  border-left: 6rpx solid var(--ink);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.deadline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.deadline-tag {
  font-size: 21rpx;
  color: var(--ink-3);
  border: 1rpx solid var(--line);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
}
.deadline-tag.is-manual {
  color: var(--amber);
  border-color: var(--amber);
}

.deadline-body {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.deadline-value {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: -0.01em;
}

/* 最晚可退日的时分秒：默认 00:00:00，可点选 */
.deadline-time-picker {
  align-self: center;
  margin-left: 12rpx;
  margin-right: auto;
}

.deadline-time {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background-color: var(--candy-1);
  color: var(--ink-1);
  font-size: 26rpx;
}

.deadline-actions {
  display: flex;
  align-items: center;
}

.link {
  font-size: 25rpx;
  color: var(--ink-2);
  border-bottom: 1rpx solid var(--line-strong);
  padding-bottom: 2rpx;
}

.deadline-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  line-height: 1.4;
}

/* 想退货：犹豫中的订单开关 */
.considering-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  background-color: rgba(224, 162, 60, 0.08);
  border-radius: var(--radius-card);
}

.considering-copy {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.considering-title {
  display: block;
  font-size: 26rpx;
  color: var(--ink-1);
}

.considering-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

/* ------------------------------------------------------------ 凭证 */
/* 凭证列表：用 margin 而非 flex gap —— gap 在低版本基础库上不生效 */
.voucher-list {
  display: flex;
  flex-wrap: wrap;
}

.voucher-item {
  position: relative;
  width: 158rpx;
  height: 158rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.voucher-img {
  width: 158rpx;
  height: 158rpx;
  border-radius: 20rpx;
  background-color: var(--line);
}

.voucher-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--ink);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.voucher-add {
  width: 158rpx;
  height: 158rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.voucher-add-plus {
  font-size: 40rpx;
  color: var(--ink-3);
  line-height: 1;
}

.voucher-add-text {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ------------------------------------------------------------ 操作区 */
.actions {
  margin-top: 64rpx;
}

.btn-primary {
  background-color: var(--candy-1);
  background-image: linear-gradient(135deg, var(--candy-1) 0%, var(--candy-2) 100%);
  color: #ffffff;
  text-align: center;
  padding: 30rpx 0;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  letter-spacing: 0.08em;
  box-shadow: var(--shadow-btn);
}

.btn-secondary {
  margin-top: 24rpx;
  background-color: var(--paper-raise);
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
  text-align: center;
  padding: 28rpx 0;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  box-shadow: var(--shadow-soft);
}

.btn-danger {
  margin-top: 24rpx;
  background-color: #fff0f3;
  color: var(--brick);
  text-align: center;
  padding: 24rpx 0;
  font-size: 27rpx;
  border-radius: var(--radius-pill);
}

.bottom-space {
  height: 100rpx;
}

/* ------------------------------------------------------------ 提示条 */
.alert {
  background-color: var(--brick-bg);
  border-left: 6rpx solid var(--brick);
  padding: 22rpx 26rpx;
  margin-top: 32rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.alert-text {
  font-size: 25rpx;
  color: var(--brick);
  line-height: 1.6;
}

.done-strip {
  background-color: var(--moss-bg);
  border-left: 6rpx solid var(--moss);
  padding: 22rpx 26rpx;
  margin-top: 32rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.done-title {
  display: block;
  font-size: 27rpx;
  color: var(--moss);
}
.done-date {
  display: block;
  font-size: 23rpx;
  color: var(--moss);
  opacity: 0.8;
  margin-top: 8rpx;
}

/* ------------------------------------------------------------ OCR 识别入口 */
.ocr-entry {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 26rpx 28rpx;
  background-color: var(--paper-raise);
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.ocr-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background-color: var(--candy-1);
  background-image: linear-gradient(135deg, var(--candy-1) 0%, var(--candy-2) 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.ocr-body {
  flex: 1;
  min-width: 0;
}
.ocr-title {
  display: block;
  font-size: 29rpx;
  color: var(--ink);
}
.ocr-sub {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}
.ocr-arrow {
  font-size: 34rpx;
  color: var(--ink-3);
  margin-left: 12rpx;
}
