/* 首页看板 —— editorial 版面感：大字、细线、克制留白 */

.page {
  padding: 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ------------------------------------------------------------ 报头 */
.masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 0 22rpx;
}
.masthead-title {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.masthead-emoji {
  font-size: 30rpx;
  margin-right: 10rpx;
  line-height: 1;
}
.masthead-search {
  font-size: 28rpx;
  margin-left: 14rpx;
  line-height: 1;
}

.masthead-gear {
  font-size: 28rpx;
  margin-left: 14rpx;
  line-height: 1;
}
.masthead-date {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
  flex-shrink: 0;
}

/* 日期与「退货看板」之间的专属标识 */
.masthead-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  font-size: 18rpx;
  line-height: 1.4;
  letter-spacing: 0.12em;
  color: #c25b7c;
  background-color: rgba(242, 120, 159, 0.1);
  border: 1rpx solid rgba(242, 120, 159, 0.22);
  border-radius: var(--radius-pill);
  white-space: nowrap;
}
.masthead-label {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.28em;
}

.rule {
  height: 1rpx;
  background-color: var(--line);
}

/* ------------------------------------------------------------ 主数值区 */
/* 左：金额层级 标题 22 < 数字 68 < 副文案 21；右：运势卡，两栏垂直居中 */
.hero {
  display: flex;
  align-items: center;
  padding: 46rpx 0 38rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.12em;
}

.hero-amount {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0 8rpx;
}

.hero-currency {
  font-size: 34rpx;
  color: var(--ink-2);
  margin-top: 14rpx;
  margin-right: 4rpx;
}

.hero-number {
  font-size: 68rpx;
  font-weight: 500;
  line-height: 1.08;
  color: var(--ink);
  letter-spacing: -0.02em;
}

.hero-meta {
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
}

/* 右侧运势卡：细线分隔，垂直居中，与左侧金额同一视觉水平 */
.hero-side {
  width: 210rpx;
  border-left: 1rpx solid rgba(178, 91, 120, 0.14);
  padding-left: 22rpx;
  display: flex;
  align-items: center;
}

.fortune-card {
  width: 100%;
  padding: 14rpx 12rpx 16rpx;
  background-color: rgba(255, 248, 251, 0.92);
  border: 1rpx solid rgba(242, 120, 159, 0.12);
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(206, 122, 152, 0.08);
}

.fortune-title {
  display: block;
  font-size: 18rpx;
  line-height: 1.4;
  color: #b87a92;
  letter-spacing: 0.02em;
}

/* 摘要按分句拼接，长度已在 JS 侧收敛：一行放得下就是一行，放不下自然换行，不切半个字 */
/* 文本框尺寸固定三行：超出补「…」，点卡片弹浮层看全文 */
.fortune-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  max-height: 72rpx;
  margin-top: 8rpx;
  font-size: 16rpx;
  line-height: 1.5;
  color: var(--ink-2);
  word-break: break-all;
}

/* ------------------------------------------------------------ 运势全文浮层 */
.fortune-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 800;
  background-color: rgba(73, 46, 56, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.fortune-pop {
  width: 100%;
  max-height: 62vh;
  padding: 32rpx 32rpx 28rpx;
  background-color: #fff8fb;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(178, 91, 120, 0.18);
  display: flex;
  flex-direction: column;
}

.fortune-pop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(242, 120, 159, 0.16);
}

.fortune-pop-title {
  font-size: 28rpx;
  color: #b87a92;
  letter-spacing: 0.02em;
}

.fortune-pop-close {
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 0 6rpx;
  line-height: 1;
}

.fortune-pop-body {
  margin-top: 20rpx;
  max-height: 46vh;
}

.fortune-pop-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-2);
  word-break: break-all;
}

/* ------------------------------------------------------------ 区块 */
.section {
  padding: 40rpx 0 24rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}
.section-side {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.section-amount {
  font-size: 26rpx;
  color: var(--ink);
  margin-right: 12rpx;
}

/* 名单收起指示：四个名单同一位置、同一字号 */
.section-caret {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  line-height: 1;
}

/* 列表标题 + 数量徽标 */
.section-title {
  display: flex;
  align-items: center;
}

/* 独立区块头（上门取件 / 已取货）：与 .section 顶部间距保持一致 */
.section-head-solo {
  padding-top: 40rpx;
}

.count-badge {
  margin-left: 12rpx;
  min-width: 36rpx;
  padding: 0 10rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background-color: var(--candy-1);
  color: #ffffff;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  box-sizing: border-box;
}

/* ------------------------------------------------------------ 名单行 */
.row {
  display: flex;
  align-items: stretch;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

/* 最后一行不要下边框：WXSS 对 :last-child 支持不稳，改由 JS 侧加类名 */
.row-last {
  border-bottom: none;
}

/* ------------------------------------------------------------ 左滑删除 */
.swipe-row {
  position: relative;
  overflow: hidden;
}

.swipe-content {
  position: relative;
  z-index: 1;
  background-color: var(--paper);
  transition: transform 0.18s ease;
}

.swipe-delete {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--brick);
  color: #ffffff;
  font-size: 26rpx;
  letter-spacing: 0.08em;
}

/* 左侧色条编码紧急度，替代传统的彩色标签块 */
.row-bar {
  width: 6rpx;
  border-radius: 3rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.bar-overdue {
  background-color: var(--brick);
}
.bar-today {
  background-color: var(--brick);
  opacity: 0.72;
}
.bar-urgent {
  background-color: var(--amber);
}
.bar-normal {
  background-color: var(--line-strong);
}

.row-body {
  flex: 1;
  min-width: 0;
}

/* 列表缩略图：点击预览凭证大图 */
.row-thumb {
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background-color: var(--paper);
  align-self: center;
  flex-shrink: 0;
}

/* 无凭证时的占位：保持与有图行同样的宽度，列表不左移 */
.row-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background-color: rgba(242, 120, 159, 0.06);
  border: 1rpx dashed rgba(242, 120, 159, 0.28);
}

.row-thumb-empty text {
  font-size: 18rpx;
  color: var(--ink-3, #8a7d83);
}

.row-line1 {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.row-platform {
  font-size: 22rpx;
  color: var(--ink-2);
  background-color: rgba(242, 120, 158, 0.12);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.row-name {
  font-size: 29rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-line2 {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 23rpx;
  color: var(--ink-3);
}

/* 取件码 + 取件时间：同一行，放不下自动换行 */
.row-pickup-line {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #b64f74;
  line-height: 1.5;
  word-break: break-all;
}

.row-amount {
  font-size: 27rpx;
  color: var(--ink-2);
}

.row-dot {
  margin: 0 10rpx;
}

.row-countdown {
  font-size: 25rpx;
  text-align: right;
}
.txt-overdue {
  color: var(--brick);
  font-weight: 500;
}
.txt-today {
  color: var(--brick);
}
.txt-urgent {
  color: var(--amber);
}
.txt-normal {
  color: var(--ink-3);
}

/* 行右侧纵排：倒计时 + 快捷「标记已申请」 */
.row-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.row-mark {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background-color: var(--paper-raise);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  padding: 6rpx 18rpx;
  line-height: 1.4;
}
.row-mark.is-marking {
  color: var(--ink-3);
  border-color: var(--line);
}

.more-note {
  padding-top: 24rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  text-align: center;
}

/* ------------------------------------------------------------ 空态 / 占位 */
.placeholder {
  padding: 70rpx 0;
  text-align: center;
}
.placeholder-text {
  font-size: 26rpx;
  color: var(--ink-3);
}
.placeholder-text.error {
  color: var(--brick);
  display: block;
  line-height: 1.6;
}
.retry {
  display: inline-block;
  margin-top: 26rpx;
  font-size: 25rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--ink);
  padding-bottom: 4rpx;
}

.empty {
  padding: 76rpx 0 60rpx;
  text-align: center;
}
.empty-mark {
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 50%;
  margin: 0 auto 30rpx;
  position: relative;
}
.empty-mark::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 1rpx;
  background-color: var(--line-strong);
  transform: translate(-50%, -50%);
}
.empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 14rpx;
}
.empty-body {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.7;
  padding: 0 40rpx;
}
.empty-cta {
  display: inline-block;
  margin-top: 40rpx;
  font-size: 27rpx;
  color: #ffffff;
  background-color: var(--candy-1);
  background-image: linear-gradient(135deg, var(--candy-1) 0%, var(--candy-2) 100%);
  padding: 20rpx 56rpx;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-btn);
}

/* ------------------------------------------------------------ 已申请展开面板 */
.applied-panel {
  background-color: var(--paper-raise);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  padding: 8rpx 28rpx 20rpx;
  margin-top: 16rpx;
}

/* 列表搜索框（临期名单 / 已申请共用，胶囊） */
.list-search {
  display: flex;
  align-items: center;
  margin: 14rpx 0 6rpx;
  padding: 14rpx 22rpx;
  background-color: #fff6fa;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
}
.list-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
}
.list-search-ph {
  color: var(--ink-3);
  opacity: 0.7;
}
.list-search-clear {
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background-color: var(--line-strong);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.applied-more {
  padding: 24rpx 0 10rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.6;
  text-align: center;
}

.bar-applied {
  background-color: var(--moss);
}

/* 已申请行右侧：状态 + 快捷「取货」 */
.row-applied-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.row-applied-note {
  font-size: 23rpx;
  color: var(--moss);
  align-self: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}
/* 在已申请行右侧列里：右对齐，去掉左侧间距 */
.row-applied-side .row-applied-note {
  align-self: flex-end;
  margin-left: 0;
}

.row-pick {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #ffffff;
  background-color: var(--moss);
  border-radius: var(--radius-pill);
  padding: 6rpx 20rpx;
  line-height: 1.4;
}
.row-pick.is-marking {
  opacity: 0.6;
}

.applied-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.bottom-space {
  height: 220rpx;
}

/* ------------------------------------------------------------ 悬浮录入 */
.fab {
  position: fixed;
  z-index: 20;
  right: 40rpx;
  bottom: calc(60rpx + constant(safe-area-inset-bottom));
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  background-color: var(--candy-1);
  background-image: linear-gradient(135deg, var(--candy-1) 0%, var(--candy-2) 100%);
  color: #ffffff;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-btn);
}
.fab-plus {
  font-size: 34rpx;
  line-height: 1;
  margin-right: 12rpx;
  margin-top: -4rpx;
}
.fab-text {
  font-size: 28rpx;
  letter-spacing: 0.04em;
}

/* ------------------------------------------------------------ 异常提示 */
.alert {
  background-color: var(--brick-bg);
  border-left: 6rpx solid var(--brick);
  padding: 26rpx 28rpx;
  margin-top: 32rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.alert-title {
  display: block;
  font-size: 28rpx;
  color: var(--brick);
  margin-bottom: 10rpx;
}
.alert-body {
  display: block;
  font-size: 24rpx;
  color: var(--brick);
  line-height: 1.6;
}
.alert-hint {
  display: block;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 12rpx;
}

.considering-hint {
  display: block;
  margin: 6rpx 0 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.considering-empty {
  padding: 28rpx 0;
}

/* 想退货名单下方的今/明到期提醒 */
.due-strip {
  display: flex;
  align-items: center;
  margin: 10rpx 0 4rpx;
  padding: 12rpx 18rpx;
  background-color: rgba(255, 246, 250, 0.86);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  color: var(--ink-3);
}

.due-title {
  margin-right: 18rpx;
  flex-shrink: 0;
}

.due-item {
  margin-right: 18rpx;
  flex-shrink: 0;
}

.due-num {
  margin-left: 4rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.due-num.is-danger {
  color: var(--brick);
  font-weight: 600;
}
