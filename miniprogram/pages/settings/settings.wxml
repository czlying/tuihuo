<view class="page">

  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">正在读取…</text>
  </view>

  <block wx:else>

    <view wx:if="{{errorMsg}}" class="alert">
      <text class="alert-text">{{errorMsg}}</text>
    </view>

    <!-- 默认退货天数 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">默认退货天数</text>
        <text class="card-hint">新建订单时使用</text>
      </view>

      <view class="stepper">
        <view class="stepper-btn tap" data-delta="-1" bindtap="onDaysStep">
          <text>−</text>
        </view>
        <text class="stepper-value num">{{defaultReturnDays}}</text>
        <view class="stepper-btn tap" data-delta="1" bindtap="onDaysStep">
          <text>+</text>
        </view>
      </view>

      <text class="card-note">收货日 + {{defaultReturnDays}} 天 = 最晚可退日；单笔订单仍可手动修改。</text>
    </view>

    <!-- 提醒档位 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">提醒档位</text>
        <text class="card-hint">可多选</text>
      </view>

      <view class="chips">
        <view
          wx:for="{{advanceOptions}}"
          wx:key="value"
          class="chip tap {{item.selected ? 'chip-on' : ''}}"
          data-index="{{index}}"
          bindtap="onToggleAdvance"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <text class="card-note">到档位当天推送一次；已推送过的档位不会重复推。</text>
    </view>

    <!-- 免打扰时段 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">免打扰时段</text>
        <text class="card-hint">该时段内不推送</text>
      </view>

      <view class="time-row">
        <picker mode="time" value="{{quietStart}}" bindchange="onQuietStartChange">
          <view class="time-pill">
            <text class="time-label">开始</text>
            <text class="time-value num">{{quietStart}}</text>
          </view>
        </picker>

        <text class="time-sep">至</text>

        <picker mode="time" value="{{quietEnd}}" bindchange="onQuietEndChange">
          <view class="time-pill">
            <text class="time-label">结束</text>
            <text class="time-value num">{{quietEnd}}</text>
          </view>
        </picker>
      </view>

      <text class="card-note">提醒每天 08:00、14:00 各尝试一次；若时段覆盖这两个时间，当天将不再推送。</text>
    </view>

    <!-- 推送状态（个人主体限制说明） -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">推送提醒</text>
        <text class="status {{subscribeFlag ? 'is-on' : ''}}">{{subscribeFlag ? '已开启' : '未开启'}}</text>
      </view>

      <text class="card-note">当前为个人主体小程序，微信暂不支持订阅消息。升级为个体工商户后可开启微信推送；在此之前，到期提醒以「首页退货名单 + 逾期提示」呈现。</text>
    </view>

    <!-- 运势接口自检（排查用，不影响正常使用） -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">运势接口自检</text>
        <text class="card-hint">排查用</text>
      </view>

      <view class="probe-btn tap" bindtap="onProbeFortune">
        <text>{{probing ? '检测中…' : '检测运势接口'}}</text>
      </view>

      <view wx:if="{{probeResult}}" class="probe-result {{probeResult.level === 'ok' ? 'is-ok' : 'is-bad'}}">
        <text class="probe-title">{{probeResult.title}}</text>
        <text class="probe-advice">{{probeResult.advice}}</text>
        <text wx:if="{{probeResult.detail}}" class="probe-detail">{{probeResult.detail}}</text>
      </view>

      <text wx:else class="card-note">点一下会真实请求一次聚合数据接口，直接告诉你是 Key 没读到、云函数没部署，还是接口没开通。</text>
    </view>

    <view class="btn-primary tap" bindtap="onSave">
      <text>{{saving ? '保存中…' : '保存设置'}}</text>
    </view>

    <view class="build-note">版本 {{buildVersion}}</view>

    <view class="bottom-space"></view>

  </block>

  <!-- 背景水印：不拦截点击 -->
</view>
