<view class="page">

  <image wx:if="{{pageBg}}" class="page-bg" src="{{pageBg}}" mode="aspectFill" />

  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">正在读取…</text>
  </view>

  <block wx:else>

    <view wx:if="{{errorMsg}}" class="alert">
      <text class="alert-text">{{errorMsg}}</text>
    </view>

    <!-- 默认退货天数 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">默认退货天数</text>
        <text class="card-hint">新建订单时使用</text>
      </view>

      <view class="stepper">
        <view class="stepper-btn tap" data-delta="-1" bindtap="onDaysStep">
          <text>−</text>
        </view>
        <text class="stepper-value num">{{defaultReturnDays}}</text>
        <view class="stepper-btn tap" data-delta="1" bindtap="onDaysStep">
          <text>+</text>
        </view>
      </view>

      <text class="card-note">收货日 + {{defaultReturnDays}} 天 = 最晚可退日；单笔订单仍可手动修改。</text>
    </view>

    <!-- 提醒档位 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">提醒档位</text>
        <text class="card-hint">可多选</text>
      </view>

      <view class="chips">
        <view
          wx:for="{{advanceOptions}}"
          wx:key="value"
          class="chip tap {{item.selected ? 'chip-on' : ''}}"
          data-index="{{index}}"
          bindtap="onToggleAdvance"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <text class="card-note">提前档按所选档位推送；到期当天还可在首页「今日到期提醒」现授权现推一条，不占用提前档的额度。</text>
    </view>

    <!-- 免打扰时段 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">免打扰时段</text>
        <text class="card-hint">该时段内不推送</text>
      </view>

      <view class="time-row">
        <picker mode="time" value="{{quietStart}}" bindchange="onQuietStartChange">
          <view class="time-pill">
            <text class="time-label">开始</text>
            <text class="time-value num">{{quietStart}}</text>
          </view>
        </picker>

        <text class="time-sep">至</text>

        <picker mode="time" value="{{quietEnd}}" bindchange="onQuietEndChange">
          <view class="time-pill">
            <text class="time-label">结束</text>
            <text class="time-value num">{{quietEnd}}</text>
          </view>
        </picker>
      </view>

      <text class="card-note">提醒每天 08:00、14:00 各尝试一次；若时段覆盖这两个时间，当天将不再推送。</text>
    </view>

    <!-- 微信推送：个人主体走「一次性订阅」，不是不支持推送 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">微信推送</text>
        <text class="status {{remindTemplateReady ? 'is-on' : ''}}">{{remindTemplateReady ? '已配置' : '未配置模板'}}</text>
      </view>

      <text class="card-note">到期提醒走微信「一次性订阅消息」，一次授权等于一条额度：提前档用记订单时授权的那条；到期当天在首页「今日到期提醒」卡片上现授权现推，消息都落在微信「服务通知」。</text>

      <text class="card-note">个人主体支持一次性订阅，不支持长期订阅（后者只对政务、医疗、交通等民生类目开放）。未授权或额度用完时，提醒仍会出现在首页名单里。</text>

      <text wx:if="{{!remindTemplateReady}}" class="card-note">当前未填模板 ID：小程序不会弹授权，云函数也不会推送。到公众平台「功能 → 订阅消息」选用模板后，把模板 ID 填进 constants 的 REMIND_TEMPLATE_ID，并给云函数配上同名环境变量。</text>
    </view>

    <!-- 运势接口自检：排查「配了 JUHE_KEY 却一直显示兜底文案」 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">运势接口</text>
        <text class="card-hint">排查用</text>
      </view>

      <view class="row tap" bindtap="onProbeFortune">
        <text class="row-label">{{fortuneProbing ? '测试中…' : '测试运势接口'}}</text>
        <view class="row-right">
          <text class="row-arrow">›</text>
        </view>
      </view>

      <text wx:if="{{fortuneConclusion}}" class="card-note">{{fortuneConclusion}}</text>
      <text wx:if="{{fortuneAdvice}}" class="card-note">{{fortuneAdvice}}</text>
      <text wx:if="{{fortuneDetail}}" class="card-note">{{fortuneDetail}}</text>

      <text class="card-note">会真发一次上游请求：检查 JUHE_KEY 是否读到、HTTP 状态与聚合数据错误码。只在排查时点，不影响正常展示。</text>
    </view>

    <!-- 更换背景图入口已隐藏：相关逻辑（onChooseBg / onResetBg / utils/page-bg）保留，恢复时去掉下面 wx:if="{{false}}" 即可 -->
    <view wx:if="{{false}}" class="card">
      <view class="card-head">
        <text class="card-title">外观</text>
        <text class="card-hint">仅本机保存</text>
      </view>

      <view class="row tap" bindtap="onChooseBg">
        <text class="row-label">更换背景图</text>
        <view class="row-right">
          <image wx:if="{{pageBg}}" class="row-thumb" src="{{pageBg}}" mode="aspectFill" />
          <text wx:else class="row-value">默认渐变</text>
          <text class="row-arrow">›</text>
        </view>
      </view>

      <text wx:if="{{pageBg}}" class="row-reset tap" bindtap="onResetBg">恢复默认背景</text>

      <text class="card-note">从相册选一张图，选中即时生效；背景不遮盖页面内容。</text>
    </view>

    <view class="btn-primary tap" bindtap="onSave">
      <text>{{saving ? '保存中…' : '保存设置'}}</text>
    </view>

    <view class="build-note">版本 {{buildVersion}}</view>

    <view class="bottom-space"></view>

  </block>

  <!-- 背景水印：不拦截点击 -->
</view>
