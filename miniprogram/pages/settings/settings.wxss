/* 设置页 —— 与全局柔彩可爱风一致：白卡、圆角、糖果色 */

.page {
  padding: 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.alert {
  background-color: var(--brick-bg);
  border-left: 6rpx solid var(--brick);
  padding: 22rpx 26rpx;
  margin-top: 32rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.alert-text {
  font-size: 25rpx;
  color: var(--brick);
  line-height: 1.6;
}

/* ------------------------------------------------------------ 卡片 */
.card {
  margin-top: 28rpx;
  padding: 30rpx 30rpx 26rpx;
  background-color: var(--paper-raise);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.card-title {
  font-size: 28rpx;
  color: var(--ink);
}
.card-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}
.card-note {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

/* ------------------------------------------------------------ 天数步进器 */
.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #fff6fa;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink);
  line-height: 1;
}
.stepper-value {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--ink);
}

/* ------------------------------------------------------------ 提醒档位 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}
.chip {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-strong);
  background-color: var(--paper-raise);
  color: var(--ink-2);
  font-size: 25rpx;
}
.chip-on {
  background-color: var(--candy-1);
  background-image: linear-gradient(135deg, var(--candy-1) 0%, var(--candy-2) 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: var(--shadow-btn);
}

/* ------------------------------------------------------------ 免打扰时间段 */
.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.time-pill {
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  border-radius: var(--radius-pill);
  background-color: #fff6fa;
  border: 1rpx solid var(--line);
}
.time-label {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-right: 12rpx;
}
.time-value {
  font-size: 30rpx;
  color: var(--ink);
}
.time-sep {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ------------------------------------------------------------ 推送状态 */
.status {
  font-size: 22rpx;
  color: var(--ink-3);
  border: 1rpx solid var(--line);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}
.status.is-on {
  color: var(--moss);
  border-color: var(--moss);
  background-color: var(--moss-bg);
}

/* ------------------------------------------------------------ 外观 · 更换背景图 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-card);
  border: 1rpx solid var(--line);
  background-color: #fff6fa;
}
.row-label {
  font-size: 26rpx;
  color: var(--ink);
}
.row-right {
  display: flex;
  align-items: center;
}
.row-value {
  font-size: 23rpx;
  color: var(--ink-3);
}
.row-thumb {
  width: 76rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background-color: #ffe9f2;
}
.row-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-3);
}
.row-reset {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--candy-1);
}

/* ------------------------------------------------------------ 保存按钮 */
.btn-primary {
  margin-top: 48rpx;
  background-color: var(--candy-1);
  background-image: linear-gradient(135deg, var(--candy-1) 0%, var(--candy-2) 100%);
  color: #ffffff;
  text-align: center;
  padding: 30rpx 0;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  letter-spacing: 0.08em;
  box-shadow: var(--shadow-btn);
}

.bottom-space {
  height: 80rpx;
}

.build-note {
  padding: 24rpx 0 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 0.06em;
}
