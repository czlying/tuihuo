/**
 * 全局样式 —— 设计令牌
 * 风格：柔彩可爱风（cute pastel）。粉/奶油/淡蓝渐变底色，柔和线条，圆角卡片。
 * 文字仍用近墨色保证可读性；小程序无法可靠加载外部字体，中文走 PingFang SC。
 */

page {
  /* 色板（柔彩） */
  --paper: #fff7fa;        /* 淡粉白，作为渐变兜底 */
  --paper-raise: #ffffff;  /* 卡片表面，纯白更干净 */
  --ink: #2a2530;          /* 近墨（带一点紫调），主文字 */
  --ink-2: #6f6878;        /* 次级文字 */
  --ink-3: #a79fb2;        /* 提示文字 */
  --line: #f2e1e8;         /* 柔和粉线 */
  --line-strong: #e7cfda;  /* 强调线条 */

  /* 语义色：逾期/临期/安全（保持辨识度，仅做柔化） */
  --brick: #c2495c;        /* 逾期、紧急 */
  --brick-bg: #ffe6ec;
  --amber: #d99a3e;        /* 临期 */
  --amber-bg: #fff2dc;
  --moss: #4f9673;         /* 已申请、安全 */
  --moss-bg: #e5f5ec;

  /* 可爱风：圆角 / 糖果色 / 柔和投影 */
  --radius-card: 26rpx;
  --radius-pill: 999rpx;
  --candy-1: #f2789f;      /* 草莓粉 */
  --candy-2: #f0a35e;      /* 蜜桃橙 */
  --shadow-soft: 0 12rpx 32rpx rgba(206, 122, 152, 0.14);
  --shadow-btn: 0 12rpx 26rpx rgba(240, 122, 158, 0.32);

  /* 可爱风背景：三团柔光 + 斜向渐变，纯 CSS 无图片资源 */
  background-color: var(--paper);
  background-image:
    radial-gradient(circle at 8% 5%, rgba(255, 183, 206, 0.45), rgba(255, 183, 206, 0) 38%),
    radial-gradient(circle at 93% 3%, rgba(255, 222, 168, 0.42), rgba(255, 222, 168, 0) 36%),
    radial-gradient(circle at 86% 96%, rgba(178, 222, 255, 0.42), rgba(178, 222, 255, 0) 44%),
    linear-gradient(165deg, #fff6fa 0%, #fffaf1 50%, #f5f9ff 100%);
  background-repeat: no-repeat;
  color: var(--ink);
  font-family: 'PingFang SC', 'HarmonyOS Sans SC', 'Noto Sans SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 数字统一使用等宽数字特性，保证账目对齐 */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  letter-spacing: -0.02em;
}


/* 细线分隔 */
.hr {
  height: 1rpx;
  background-color: var(--line);
}

/* 通用区块标题：小字号 + 字间距，杂志栏目感 */
.section-label {
  font-size: 22rpx;
  letter-spacing: 0.22em;
  color: var(--ink-3);
}

/* 通用按压反馈 */
.tap {
  transition: opacity 0.15s ease;
}
.tap:active {
  opacity: 0.6;
}

/* 页面背景水印：不再使用固定覆盖层，避免拦截点击 */
.page {
  background-image: url("data:image/png;base64,");
  background-repeat: repeat;
  background-size: 300rpx 300rpx;
}

/**
 * 自定义背景图（设置页可更换）
 * 铺满视口，靠负 z-index 落在页面背景与内容之间：
 * .page 建立层叠上下文后，负 z-index 子元素会盖住 .page 自身的水印，
 * 同时仍在全部内容之下，因此不会遮挡任何显示、也不拦截点击。
 */
.page {
  position: relative;
  z-index: 1;
}

.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}
